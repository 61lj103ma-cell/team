# FlowPilot AI Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Leave empty or keep local default; if local mongod is not detected, 
# FlowPilot AI will seamlessly auto-launch an in-memory DB for hassle-free zero-config review!
MONGODB_URI=mongodb://127.0.0.1:27017/flowpilot

# JWT Secret and Expiration
JWT_SECRET=flowpilot_ai_secure_enterprise_jwt_secret_key_2025_prod
JWT_EXPIRES_IN=7d

# Google Gemini API Key (Server-side ONLY, never expose in frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# Supabase Enterprise Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_REST_URL=https://your-project.supabase.co/rest/v1/
